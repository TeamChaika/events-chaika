# Local preview only. Production refuses demo mode.
PORT=8787
APP_ORIGIN=http://localhost:5173
DEMO_MODE=true
ADMIN_PASSWORD=
SCANNER_PASSWORD=
DB_PATH=./data/events.sqlite
# Set to 1 only behind exactly one trusted reverse proxy.
TRUST_PROXY_HOPS=0
# disabled | sandbox | live. Keep disabled until the QRM terminal is configured.
QRM_MODE=disabled
QRM_API_KEY=
QRM_LIVE_API_KEY=
QRM_API_BASE_URL=
QRM_EXPECTED_MERCHANT_ID=
# Callback URL must be publicly reachable over HTTPS in QRM modes.
# Real delivery stays disabled until explicitly configured.
DELIVERY_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SMS_RU_API_ID=
